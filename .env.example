# Primary model: ARK-hosted DeepSeek via the Responses API (routed to ArkChatModel
# because base_url host is volces.com). override with any OpenAI-compatible endpoint:
# EH_MODEL / EH_BASE_URL / EH_API_KEY.
EH_MODEL=deepseek-v4-flash-ga-260731
EH_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EH_API_KEY=

# Filesystem root exposed to tools; runs never leave it.
EH_WORKSPACE=./workspace

# ARK key; EH_API_KEY above can also mirror it for a default-authed run.
ARK_API_KEY=